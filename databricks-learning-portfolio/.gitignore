# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
.databrickscfg

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

