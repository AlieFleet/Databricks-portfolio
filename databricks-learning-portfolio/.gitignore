# Local data and generated outputs (keep folder structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Common large files
*.csv
*.parquet
*.jsonl
*.avro
*.orc
*.zip
*.tar
*.gz
*.db
*.sqlite
*.whl

# Exceptions: allow small, intentionally committed sample files by removing
# or narrowing the relevant patterns above when a project needs them.
